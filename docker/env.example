# Nexa CRM — Docker deployment overrides.
#
# Copy this file to the repository root as .env, then edit it:
#
#     cp docker/env.example .env
#
# Docker Compose reads .env automatically. These values only tune the
# containers; Laravel's own settings (APP_KEY, mail, queues) live in
# backend/.env, which is passed to the api, worker and scheduler containers
# via env_file.
#
# Keep APP_KEY unset in .env: the api service generates one on first boot and
# persists it in the nexa-storage volume.
#
# The API base URL is compiled into the SPA. Keep /api/v1 for same-origin
# proxying through nginx; rebuild the web image after changing it.

HTTP_PORT=8080
PHPMYADMIN_PORT=8082
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_LEVEL=info

# MariaDB credentials. Keep DB_PASSWORD set in the root .env; compose refuses
# to start without it (MYSQL_ROOT_PASSWORD defaults to DB_PASSWORD, like Sail).
DB_PASSWORD=
DB_DATABASE=nexa
DB_USERNAME=nexa

# Hard memory ceilings. Total worst case: 512m + 256m + 48m + 256m + 128m + 128m =
# 1328 MB. For a small single-user box, API_MEM_LIMIT=192m and
# MYSQL_MEM_LIMIT=384m work; raise them (and pm.max_children in
# backend/docker/php-fpm.conf) for more concurrent requests.
MYSQL_MEM_LIMIT=512m
MYSQL_MEM_RESERVATION=192m
API_MEM_LIMIT=256m
API_MEM_RESERVATION=96m
WEB_MEM_LIMIT=48m
WEB_MEM_RESERVATION=16m
WORKER_MEM_LIMIT=256m
WORKER_MEM_RESERVATION=96m
SCHEDULER_MEM_LIMIT=128m
SCHEDULER_MEM_RESERVATION=32m
PMA_MEM_LIMIT=128m
PMA_MEM_RESERVATION=32m
PMA_UPLOAD_LIMIT=64M

# One-shot bootstrap switch. Migrations are idempotent and safe to leave
# enabled.
RUN_MIGRATIONS=true

# Leave this as a relative path for same-origin nginx proxying.
VITE_API_BASE_URL=/api/v1
