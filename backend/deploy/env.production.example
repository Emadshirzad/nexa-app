# Template for the production .env on irpaymard.
#
# The real file lives at /var/www/nexa/shared/.env on the server and is
# symlinked into each release by Envoy. Never commit the real values: only the
# non-secret scaffolding below matches what compose.yaml + compose.server.yml
# interpolate.
#
# Values filled in by backend/deploy/provision-server.sh are marked.
# Copy this file into backend/deploy/provision-server.sh's generated .env only.

APP_NAME=Nexa
APP_ENV=production
APP_DEBUG=false

# Public origin served by traefik (also used by the API container).
APP_URL=https://nexa.shirzadd.ir

# Content origin of the SPA build (compiled into the bundle by vite).
VITE_API_BASE_URL=/api/v1

APP_LOCALE=fa

# Database — the SHARED lemp mariadb on irpaymard (container `mariadb`).
# Provision-server.sh creates the `nexa` database + `nexa_app` user and sets:
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=nexa
DB_USERNAME=nexa_app
# DB_PASSWORD=<generated by provision-server.sh, stored only on the server>

# Memory-aware resource ceilings (see compose.yaml comments).
API_MEM_LIMIT=256m
WEB_MEM_LIMIT=48m

# Frontend bundle is built in CI and shipped as dist/ — the compose build just
# wraps it. Nothing to configure here beyond VITE_API_BASE_URL.
